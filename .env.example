LOG_LEVEL=INFO

# Anomaly detection
VS_OWN_SPIKE_THRESHOLD_PCT=10.0
VS_PEER_CREEP_THRESHOLD_PCT=20.0
MIN_OWN_RISE_FOR_PEER_CREEP_PCT=5.0
HYSTERESIS_KEEP_PEER_PCT=15.0

# Guardrails
MAX_WEEKS_OPEN_ENDED_EFFECT=8
MAGNITUDE_TOLERANCE_PCT=3.0

# LLM (provider: groq | gemini | fake)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=30.0

# Published Pricing (USD per 1M tokens)
PRICE_INPUT_PER_MTOK=0.59
PRICE_OUTPUT_PER_MTOK=0.79

RETRIEVAL_TOP_K=3